# Usa una imagen base de PHP con extensiones requeridas para Laravel
FROM php:8.2-fpm

# Instala herramientas necesarias y Node.js
RUN apt-get update && apt-get install -y \
    unzip \
    libzip-dev \
    libpng-dev \
    git \
    curl \
    gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@11.0.0 # Instala la versión específica de npm compatible

# Instala Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Establece el directorio de trabajo
WORKDIR /var/www/html

# Copia los archivos del proyecto al contenedor
COPY . .

# Instala las dependencias de PHP
RUN composer install --no-dev --optimize-autoloader

# Instala las dependencias de Node.js y compila los activos
RUN npm install && npm run build

# Crea un enlace simbólico para el almacenamiento
RUN php artisan storage:link

# Genera la clave de la aplicación
RUN php artisan key:generate

# Expone el puerto 8080
EXPOSE 8080

# Comando para iniciar Laravel
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8080"]
